{
  "name": "testingecommershop",
  "version": "1.0.0",
  "description": "Playwright automation framework for ECOMMER frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test tests/smoke/",
    "test:integration": "playwright test tests/integration/",
    "test:stage": "ENV=stage playwright test",
    "test:stage:smoke": "ENV=stage playwright test tests/smoke/",
    "test:stage:integration": "ENV=stage playwright test tests/integration/",
    "test:authentication": "playwright test tests/authentication/",
    "test:regression": "playwright test tests/regression/",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.4",
    "dotenv": "^17.4.2",
    "eslint": "10.7.0",
    "eslint-plugin-playwright": "2.10.5",
    "prettier": "3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
